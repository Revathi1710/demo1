# Database Configuration
MONGODB_URI=mongodb://localhost:27017/inquiry_management
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/inquiry_management

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourcompany.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Redis Configuration (for session management if needed)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Third-party Integrations
WEBHOOK_SECRET=your-webhook-secret
SMS_API_KEY=your-sms-api-key
NOTIFICATION_SERVICE_URL=http://localhost:8080

# Database Backup
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30